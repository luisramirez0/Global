# Copiar a .env y completar. NUNCA commitear .env ni valores reales.
# Base de datos (perfil dev / docker compose)
DB_NAME=global
DB_URL=jdbc:mysql://localhost:3306/global
DB_USER=global
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# Aplicacion
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (se usa desde C-03; definir un secreto largo y aleatorio)
JWT_SECRET=
JWT_EXPIRATION_MIN=30

# SMTP gratuito (se usa desde C-09)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Frontend (build)
VITE_API_BASE_URL=http://localhost:8080/api

DEV_ADMIN_EMAIL=admin@dev.local
DEV_ADMIN_PASSWORD=